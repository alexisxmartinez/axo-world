#!/bin/sh
# Blocks commits that contain internal identifiers. Install: git config core.hooksPath .githooks
PATTERN='SRS20|EPR[ _]?[0-9]|IV ?8[0-9]{3}|DaVinci|OneID|Widen|PRISM|Hermes|ADP-[0-9]'
export PATTERN
# No arguments checks the index; --range BASE HEAD checks a push or pull request.
exec node --input-type=commonjs - "$@" <<'NODE'
const { spawnSync } = require('node:child_process');

function git(args) {
  const result = spawnSync('git', args, {
    encoding: 'utf8',
    maxBuffer: 32 * 1024 * 1024,
  });
  if (result.error || result.status !== 0) throw new Error('git failed');
  return result.stdout;
}

try {
  if (!process.env.PATTERN) throw new Error('missing policy');
  const pattern = new RegExp(process.env.PATTERN, 'i');
  const args = process.argv.slice(2);
  let revisions = ['--cached'];
  if (args.length === 3 && args[0] === '--range') {
    revisions = args.slice(1).map(ref =>
      git(['rev-parse', '--verify', '--end-of-options', `${ref}^{tree}`]).trim());
  } else if (args.length !== 0) {
    throw new Error('invalid arguments');
  }

  const options = ['--no-ext-diff', '--no-textconv', '--no-color', '--no-renames', '--text'];
  const files = git(['diff', ...options, '--diff-filter=ACMT', '--name-only', '-z', ...revisions, '--'])
    .split('\0').filter(Boolean);
  let blocked = false;
  for (const file of files) {
    // release/index.html is the published standalone bundle. Its packed data produces false matches
    // on the raw bytes, so tests/release.test.mjs unpacks it and checks the real text against this pattern.
    if (file === 'release/index.html') continue;
    const patch = git(['diff', ...options, '--unified=0', ...revisions, '--', file]);
    let lineNumber = null;
    for (const line of patch.split('\n')) {
      const hunk = /^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@/.exec(line);
      if (hunk) {
        lineNumber = Number(hunk[1]);
      } else if (lineNumber !== null && line.startsWith('+')) {
        if (pattern.test(line.slice(1))) {
          // Quoting also prevents filenames from injecting log commands or newlines.
          console.error(`${JSON.stringify(file)}:${lineNumber}`);
          blocked = true;
        }
        lineNumber++;
      } else if (lineNumber !== null && line.startsWith(' ')) {
        lineNumber++;
      }
    }
  }
  process.exitCode = blocked ? 1 : 0;
} catch {
  console.error('Identifier check could not read the policy or diff.');
  process.exitCode = 2;
}
NODE
